// Memory.hdl - the Hack data memory (Nand to Tetris, project 5)
//
//   address 0     .. 16383 : RAM16K
//   address 16384 .. 24575 : Screen (8K)
//   address 24576          : Keyboard
//
// address[14] = 0            -> RAM
// address[14] = 1, [13] = 0  -> Screen
// address[14] = 1, [13] = 1  -> Keyboard

CHIP Memory {

    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // send 'load' only to the chip that is selected
    DMux(in=load, sel=address[14], a=loadRam, b=loadHigh);
    Not(in=address[13], out=notBit13);
    And(a=loadHigh, b=notBit13, out=loadScreen);

    RAM16K(in=in, load=loadRam,    address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyOut);

    // read: pick the right chip's output
    Mux16(a=screenOut, b=keyOut, sel=address[13], out=highOut);
    Mux16(a=ramOut,    b=highOut, sel=address[14], out=out);
}
